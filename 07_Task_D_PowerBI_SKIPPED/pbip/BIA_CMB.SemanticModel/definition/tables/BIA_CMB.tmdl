	measure 'Total Delayed Flights' = CALCULATE(COUNT('BIA_CMB'[Flight_ID]), 'BIA_CMB'[Status] = "Delayed")
		lineageTag: 0ed2d34f-3b2c-4ad7-a349-3d42d11310da

	measure 'Warning Alerts' = CALCULATE(COUNT('BIA_CMB'[Flight_ID]), 'BIA_CMB'[Alert_Status] = "Warning")
		lineageTag: 152b1fe6-973d-440e-a93b-eb8647d1ef2f

	measure 'Normal Alerts' = CALCULATE(COUNT('BIA_CMB'[Flight_ID]), 'BIA_CMB'[Alert_Status] = "Normal")
