		lineageTag: 1b56354f-9231-4d18-b813-756cfce98155

	measure 'Total Passengers' = SUM('BIA_CMB'[Passenger_Count])
		lineageTag: 7f9130d2-a89b-4241-8014-78654e15b744

	measure 'Average Load Factor' = AVERAGE('BIA_CMB'[Load_Factor_%])
