table BIA_CMB
	lineageTag: a3e107ac-8ba6-4d6f-9a26-481314ebe37a

	measure 'Total Flights' = COUNT('BIA_CMB'[Flight_ID])
		lineageTag: add0213b-e0ee-4b94-8d1b-9f566355b433

	measure 'Total Arrivals' = CALCULATE(COUNT('BIA_CMB'[Flight_ID]), 'BIA_CMB'[Flight_Type] = "Arrival")
		lineageTag: 0c8a42f8-e020-4d61-94aa-e9aee7bfc9fb

	measure 'Total Departures' = CALCULATE(COUNT('BIA_CMB'[Flight_ID]), 'BIA_CMB'[Flight_Type] = "Departure")
		lineageTag: 177c2e72-0f6f-49a6-9c34-5d15e56d317a

	measure 'Delayed Flights' = CALCULATE(COUNT('BIA_CMB'[Flight_ID]), 'BIA_CMB'[Status] = "Delayed")
		lineageTag: 841e298b-c293-4115-aa1a-b0fc7039f96f

	measure 'On-Time Flights' = CALCULATE(COUNT('BIA_CMB'[Flight_ID]), 'BIA_CMB'[Status] = "On Time")
